{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Porch",
  "version": "0.2.0",
  "identifier": "com.tdotlab.porch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Porch",
        "width": 1120,
        "height": 740,
        "minWidth": 380,
        "minHeight": 520,
        "backgroundColor": "#1e2433"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ws: wss: ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Somewhere to sit with your friends.",
    "category": "SocialNetworking"
  }
}
